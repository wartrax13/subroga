# Copie para backend/.env (nunca versionar o .env). Variáveis já definidas no ambiente têm prioridade.

# Segredo do JWT (HS256). Sem valor, o servidor gera um aleatório a cada start (logins caem ao reiniciar).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUBROGA_JWT_SECRET=

# Banco e arquivos (padrão: backend/storage/app.db e backend/storage/)
# SUBROGA_DB_URL=sqlite:///./storage/app.db
# SUBROGA_STORAGE_DIR=./storage

# Origens CORS separadas por vírgula (padrão: localhost/127.0.0.1 em qualquer porta)
# SUBROGA_CORS_ORIGINS=http://localhost:5173

# Limite por arquivo no upload público
SUBROGA_MAX_UPLOAD_MB=50

# Pasta do frontend estático (padrão: ../frontend)
# SUBROGA_FRONTEND_DIR=../frontend

# Provedor de IA: openai | anthropic | heuristic (sem valor: escolhe pelo que tiver chave)
# SUBROGA_LLM_PROVIDER=heuristic
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
